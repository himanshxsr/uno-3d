{
  "name": "uno3d-relay",
  "version": "1.0.0",
  "private": true,
  "description": "UNO 3D online room relay for friends",
  "main": "relay.js",
  "scripts": {
    "start": "node relay.js",
    "health": "node -e \"require('http').get('http://127.0.0.1:'+(process.env.HEALTH_PORT||17779)+'/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e);process.exit(1)})\""
  },
  "engines": {
    "node": ">=18"
  }
}
